// SHA256 Compression Function
// 64 rounds, 8 working variables locked to physical registers R2-R9
// Zero register spill — compiler forbidden from touching R2-R9

motor sha256_compress {
    @register(R0) float* msg;
    @register(R1) float* state;
    @register(R2) float a;
    @register(R3) float b;
    @register(R4) float c;
    @register(R5) float d;
    @register(R6) float e;
    @register(R7) float f;
    @register(R8) float g;
    @register(R9) float h;

    a = state[0];
    b = state[1];
    c = state[2];
    d = state[3];
    e = state[4];
    f = state[5];
    g = state[6];
    h = state[7];

    for (int i = 0; i < 64; i = i + 1) {
        float w;
        float t1;
        float t2;
        w  = msg[i];
        t1 = h + e + w;
        t2 = a + b + c;
        h  = g;
        g  = f;
        f  = e;
        e  = d + t1;
        d  = c;
        c  = b;
        b  = a;
        a  = t1 + t2;
    }

    state[0] = a + state[0];
    state[1] = b + state[1];
    state[2] = c + state[2];
    state[3] = d + state[3];
    state[4] = e + state[4];
    state[5] = f + state[5];
    state[6] = g + state[6];
    state[7] = h + state[7];
}

transmission sha256_launch {
    grid  (1, 1, 1);
    block (256, 1, 1);
}

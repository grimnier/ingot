    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;
    rrotr = (rtvr << 11) | (rtvr >> 21);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R79: msg[11] s=11 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;

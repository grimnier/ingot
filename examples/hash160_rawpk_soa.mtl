    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R77: msg[3] s=13 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + x3 + 0x00000000;
    rrotr = (rtvr << 13) | (rtvr >> 19);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;

    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;

    // RIPEMD160 final combination
    u32 fin0; u32 fin1; u32 fin2; u32 fin3; u32 fin4;
    fin0 = 0xEFCDAB89 + cl + dr;
    fin1 = 0x98BADCFE + dl + er;
    fin2 = 0x10325476 + el + ar;
    fin3 = 0xC3D2E1F0 + al + br;
    fin4 = 0x67452301 + bl + cr;

    // Coalesced SoA stores: o_idx steps by total_n per word (1 cache line per store)
    int o_idx;
    o_idx = gid;
    hash160_out[o_idx] = fin0;
    o_idx = o_idx + total_n;
    hash160_out[o_idx] = fin1;
    o_idx = o_idx + total_n;
    hash160_out[o_idx] = fin2;
    o_idx = o_idx + total_n;
    hash160_out[o_idx] = fin3;
    o_idx = o_idx + total_n;
    hash160_out[o_idx] = fin4;
}

transmission hash160_rawpk_launch {
    grid  (1, 1, 1);
    block (256, 1, 1);
}
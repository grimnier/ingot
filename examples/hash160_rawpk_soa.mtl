    rrotr = (rtvr << 8) | (rtvr >> 24);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R51: msg[1] s=11 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + x1 + 0x7a6d76e9;
    rrotr = (rtvr << 11) | (rtvr >> 21);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R52: msg[3] s=14 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + x3 + 0x7a6d76e9;
    rrotr = (rtvr << 14) | (rtvr >> 18);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R53: msg[11] s=14 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000000 + 0x7a6d76e9;
    rrotr = (rtvr << 14) | (rtvr >> 18);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R54: msg[15] s=6 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000000 + 0x7a6d76e9;
    rrotr = (rtvr << 6) | (rtvr >> 26);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R55: msg[0] s=14 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + x0 + 0x7a6d76e9;
    rrotr = (rtvr << 14) | (rtvr >> 18);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R56: msg[5] s=6 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + x5 + 0x7a6d76e9;
    rrotr = (rtvr << 6) | (rtvr >> 26);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R57: msg[12] s=9 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000000 + 0x7a6d76e9;
    rrotr = (rtvr << 9) | (rtvr >> 23);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R58: msg[2] s=12 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + x2 + 0x7a6d76e9;
    rrotr = (rtvr << 12) | (rtvr >> 20);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R59: msg[13] s=9 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000000 + 0x7a6d76e9;
    rrotr = (rtvr << 9) | (rtvr >> 23);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R60: msg[9] s=12 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000000 + 0x7a6d76e9;
    rrotr = (rtvr << 12) | (rtvr >> 20);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R61: msg[7] s=5 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + x7 + 0x7a6d76e9;
    rrotr = (rtvr << 5) | (rtvr >> 27);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R62: msg[10] s=15 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000000 + 0x7a6d76e9;
    rrotr = (rtvr << 15) | (rtvr >> 17);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R63: msg[14] s=8 k=0x7a6d76e9
    rfr   = lop3(br, cr, dr, 0xca);
    rtvr  = ar + rfr + 0x00000100 + 0x7a6d76e9;
    rrotr = (rtvr << 8) | (rtvr >> 24);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R64: msg[12] s=8 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;
    rrotr = (rtvr << 8) | (rtvr >> 24);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R65: msg[15] s=5 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;
    rrotr = (rtvr << 5) | (rtvr >> 27);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R66: msg[10] s=12 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;
    rrotr = (rtvr << 12) | (rtvr >> 20);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R67: msg[4] s=9 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + x4 + 0x00000000;
    rrotr = (rtvr << 9) | (rtvr >> 23);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;

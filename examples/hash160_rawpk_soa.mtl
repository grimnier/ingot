    br    = rtvr;
    // R68: msg[1] s=12 k=0x00000000
    rfr   = lop3(br, cr, dr, 0x96);
    rtvr  = ar + rfr + x1 + 0x00000000;
    rrotr = (rtvr << 12) | (rtvr >> 20);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;

    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R78: msg[9] s=11 k=0x00000000
    rfr   = br ^ cr ^ dr;
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;
    rrotr = (rtvr << 11) | (rtvr >> 21);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;
    // R79: msg[11] s=11 k=0x00000000
    rfr   = br ^ cr ^ dr;
    rtvr  = ar + rfr + 0x00000000 + 0x00000000;
    rrotr = (rtvr << 11) | (rtvr >> 21);
    rtvr  = rrotr + er;
    ar    = er;
    er    = dr;
    dr    = (cr << 10) | (cr >> 22);
    cr    = br;
    br    = rtvr;

    // RIPEMD160 final combination with hardcoded initial state
    // Standard RIPEMD-160 final:
    //   t   = h1 + cl + dr  (h1=0xEFCDAB89)
    //   h1' = h2 + dl + er  (h2=0x98BADCFE)
    //   h2' = h3 + el + ar  (h3=0x10325476)
    //   h3' = h4 + al + br  (h4=0xC3D2E1F0)
    //   h4' = h0 + bl + cr  (h0=0x67452301)
    //   h0' = t
    u32 fin0; u32 fin1; u32 fin2; u32 fin3; u32 fin4;
    fin0 = 0xEFCDAB89 + cl + dr;
    fin1 = 0x98BADCFE + dl + er;
    fin2 = 0x10325476 + el + ar;
    fin3 = 0xC3D2E1F0 + al + br;
    fin4 = 0x67452301 + bl + cr;

    hash160_out[o_base + 0] = fin0;
    hash160_out[o_base + 1] = fin1;
    hash160_out[o_base + 2] = fin2;
    hash160_out[o_base + 3] = fin3;
    hash160_out[o_base + 4] = fin4;
}

transmission hash160_compact_launch {
    grid  (1, 1, 1);
    block (256, 1, 1);
}
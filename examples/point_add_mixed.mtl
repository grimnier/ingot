// secp256k1 Jacobian+Affine mixed point addition: (X1:Y1:Z1) + (x2,y2) → (X1:Y1:Z1)
// Formula: 8M + 3S (no RCB — walkers never hit identity on Pollard Rho hot path)
//
// Z1sq  = Z1^2              (S)
// U2    = x2 * Z1sq         (M)  ─┐ interleaved (sequential; warp scheduler hides latency)
// Z1cu  = Z1 * Z1sq         (M)  ─┘
// S2    = y2 * Z1cu         (M)
// H     = U2 - X1           (field sub)
// R     = S2 - Y1           (field sub)
// Hsq   = H^2               (S)  ─┐ interleaved
// Z3    = Z1 * H            (M)  ─┘
// Hcu   = H * Hsq           (M)
// X1Hsq = X1 * Hsq          (M)
// Rsq   = R^2               (S)
// X3    = Rsq - Hcu - 2*X1Hsq   (field arithmetic)
// T0    = R * (X1Hsq - X3)  (M)  ─┐ interleaved
// T1    = Y1 * Hcu          (M)  ─┘
// Y3    = T0 - T1            (field sub)
// Write-back X1←X3, Y1←Y3, Z1←Z3
//
// Register map:
//   R0..R3   = X1  (walker X, locked across all hops)
//   R4..R7   = Y1  (walker Y, locked)
//   R8..R11  = Z1  (walker Z, locked)
//   R12..R15 = x2  (affine x, locked, dead after H computed)
//   R16..R19 = y2  (affine y, locked, dead after R computed)
//
// mt0..mt7 = shared carry-chain temps, reused across all 8 field muls
// ~80 physical registers/thread → 3 blocks/SM → 24 warps → full latency hiding

motor point_add_mixed {

    // ── Walker state: permanently locked, survive every hop ──────────────────
    @register(R0)  u64 X1_0; @register(R1)  u64 X1_1;
    @register(R2)  u64 X1_2; @register(R3)  u64 X1_3;
    @register(R4)  u64 Y1_0; @register(R5)  u64 Y1_1;
    @register(R6)  u64 Y1_2; @register(R7)  u64 Y1_3;
    @register(R8)  u64 Z1_0; @register(R9)  u64 Z1_1;
    @register(R10) u64 Z1_2; @register(R11) u64 Z1_3;

    // ── Affine table point: locked, recycled after H and R computed ───────────
    @register(R12) u64 x2_0; @register(R13) u64 x2_1;
    @register(R14) u64 x2_2; @register(R15) u64 x2_3;
    @register(R16) u64 y2_0; @register(R17) u64 y2_1;
    @register(R18) u64 y2_2; @register(R19) u64 y2_3;

    // ── Shared multiply carry temps — reused across all field multiplications ──
    u64 mt0; u64 mt1; u64 mt2; u64 mt3;
    u64 mt4; u64 mt5; u64 mt6; u64 mt7;
    u64 mt4l; u64 mt4h;
    u64 mt5l; u64 mt5h;
    u64 mt6l; u64 mt6h;
    u64 mt7l; u64 mt7h;
    u64 c977; u64 c32; u64 cC;
    u64 t4C_lo; u64 t4C_hi;
    c977 = 977;
    c32  = 32;
    cC   = 0x1000003D1;

    // ── Field intermediate values ─────────────────────────────────────────────
    u64 Zs0; u64 Zs1; u64 Zs2; u64 Zs3;
    u64 Zc0; u64 Zc1; u64 Zc2; u64 Zc3;
    u64 U0;  u64 U1;  u64 U2v; u64 U3;
    u64 S0;  u64 S1;  u64 S2v; u64 S3;
    u64 H0;  u64 H1;  u64 H2;  u64 H3;
    u64 Rv0; u64 Rv1; u64 Rv2; u64 Rv3;
    u64 Hs0; u64 Hs1; u64 Hs2; u64 Hs3;
    u64 Z30; u64 Z31; u64 Z32; u64 Z33;
    u64 Hc0; u64 Hc1; u64 Hc2; u64 Hc3;
    u64 XH0; u64 XH1; u64 XH2; u64 XH3;
    u64 Rs0; u64 Rs1; u64 Rs2; u64 Rs3;
    u64 XH2a; u64 XH2b; u64 XH2c; u64 XH2d;
    u64 X30;  u64 X31;  u64 X32;  u64 X33;
    u64 DX0;  u64 DX1;  u64 DX2;  u64 DX3;
    u64 T00;  u64 T01;  u64 T02;  u64 T03;
    u64 T10;  u64 T11;  u64 T12;  u64 T13;
    u64 Y30;  u64 Y31;  u64 Y32;  u64 Y33;

    // ── Subtraction temps ─────────────────────────────────────────────────────
    u64 sb; u64 PL0; u64 ap0;
    PL0 = 0xFFFFFFFEFFFFFC2F;

    // ── Doubling-temp for 2*X1Hsq ─────────────────────────────────────────────
    u64 dbl_cy;
    u64 ds0; u64 ds1; u64 ds2; u64 ds3; u64 db; u64 dnb;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 1: Z1sq = Z1 * Z1  (squaring — a = b = Z1)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(Z1_0, Z1_0);
    mt1 = mulhi64(Z1_0, Z1_0);
    mt1 = mad_lo_cc64(Z1_0, Z1_1, mt1);
    mt2 = madc_hi64(Z1_0, Z1_1, 0);
    mt2 = mad_lo_cc64(Z1_0, Z1_2, mt2);
    mt3 = madc_hi64(Z1_0, Z1_2, 0);
    mt3 = mad_lo_cc64(Z1_0, Z1_3, mt3);
    mt4 = madc_hi64(Z1_0, Z1_3, 0);
    mt1 = mad_lo_cc64(Z1_1, Z1_0, mt1);
    mt2 = madc_lo_cc64(Z1_1, Z1_1, mt2);
    mt3 = madc_lo_cc64(Z1_1, Z1_2, mt3);
    mt4 = madc_lo_cc64(Z1_1, Z1_3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(Z1_1, Z1_0, mt2);
    mt3 = madc_hi_cc64(Z1_1, Z1_1, mt3);
    mt4 = madc_hi_cc64(Z1_1, Z1_2, mt4);
    mt5 = madc_hi64(Z1_1, Z1_3, mt5);
    mt2 = mad_lo_cc64(Z1_2, Z1_0, mt2);
    mt3 = madc_lo_cc64(Z1_2, Z1_1, mt3);
    mt4 = madc_lo_cc64(Z1_2, Z1_2, mt4);
    mt5 = madc_lo_cc64(Z1_2, Z1_3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(Z1_2, Z1_0, mt3);
    mt4 = madc_hi_cc64(Z1_2, Z1_1, mt4);
    mt5 = madc_hi_cc64(Z1_2, Z1_2, mt5);
    mt6 = madc_hi64(Z1_2, Z1_3, mt6);
    mt3 = mad_lo_cc64(Z1_3, Z1_0, mt3);
    mt4 = madc_lo_cc64(Z1_3, Z1_1, mt4);
    mt5 = madc_lo_cc64(Z1_3, Z1_2, mt5);
    mt6 = madc_lo_cc64(Z1_3, Z1_3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(Z1_3, Z1_0, mt4);
    mt5 = madc_hi_cc64(Z1_3, Z1_1, mt5);
    mt6 = madc_hi_cc64(Z1_3, Z1_2, mt6);
    mt7 = madc_hi64(Z1_3, Z1_3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    Zs0 = mt0; Zs1 = mt1; Zs2 = mt2; Zs3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 2: U2 = x2 * Z1sq  (M) — SEQUENTIAL then Step 3 (warp scheduler)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(x2_0, Zs0);
    mt1 = mulhi64(x2_0, Zs0);
    mt1 = mad_lo_cc64(x2_0, Zs1, mt1);
    mt2 = madc_hi64(x2_0, Zs1, 0);
    mt2 = mad_lo_cc64(x2_0, Zs2, mt2);
    mt3 = madc_hi64(x2_0, Zs2, 0);
    mt3 = mad_lo_cc64(x2_0, Zs3, mt3);
    mt4 = madc_hi64(x2_0, Zs3, 0);
    mt1 = mad_lo_cc64(x2_1, Zs0, mt1);
    mt2 = madc_lo_cc64(x2_1, Zs1, mt2);
    mt3 = madc_lo_cc64(x2_1, Zs2, mt3);
    mt4 = madc_lo_cc64(x2_1, Zs3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(x2_1, Zs0, mt2);
    mt3 = madc_hi_cc64(x2_1, Zs1, mt3);
    mt4 = madc_hi_cc64(x2_1, Zs2, mt4);
    mt5 = madc_hi64(x2_1, Zs3, mt5);
    mt2 = mad_lo_cc64(x2_2, Zs0, mt2);
    mt3 = madc_lo_cc64(x2_2, Zs1, mt3);
    mt4 = madc_lo_cc64(x2_2, Zs2, mt4);
    mt5 = madc_lo_cc64(x2_2, Zs3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(x2_2, Zs0, mt3);
    mt4 = madc_hi_cc64(x2_2, Zs1, mt4);
    mt5 = madc_hi_cc64(x2_2, Zs2, mt5);
    mt6 = madc_hi64(x2_2, Zs3, mt6);
    mt3 = mad_lo_cc64(x2_3, Zs0, mt3);
    mt4 = madc_lo_cc64(x2_3, Zs1, mt4);
    mt5 = madc_lo_cc64(x2_3, Zs2, mt5);
    mt6 = madc_lo_cc64(x2_3, Zs3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(x2_3, Zs0, mt4);
    mt5 = madc_hi_cc64(x2_3, Zs1, mt5);
    mt6 = madc_hi_cc64(x2_3, Zs2, mt6);
    mt7 = madc_hi64(x2_3, Zs3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    U0 = mt0; U1 = mt1; U2v = mt2; U3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 3: Z1cu = Z1 * Z1sq  (M)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(Z1_0, Zs0);
    mt1 = mulhi64(Z1_0, Zs0);
    mt1 = mad_lo_cc64(Z1_0, Zs1, mt1);
    mt2 = madc_hi64(Z1_0, Zs1, 0);
    mt2 = mad_lo_cc64(Z1_0, Zs2, mt2);
    mt3 = madc_hi64(Z1_0, Zs2, 0);
    mt3 = mad_lo_cc64(Z1_0, Zs3, mt3);
    mt4 = madc_hi64(Z1_0, Zs3, 0);
    mt1 = mad_lo_cc64(Z1_1, Zs0, mt1);
    mt2 = madc_lo_cc64(Z1_1, Zs1, mt2);
    mt3 = madc_lo_cc64(Z1_1, Zs2, mt3);
    mt4 = madc_lo_cc64(Z1_1, Zs3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(Z1_1, Zs0, mt2);
    mt3 = madc_hi_cc64(Z1_1, Zs1, mt3);
    mt4 = madc_hi_cc64(Z1_1, Zs2, mt4);
    mt5 = madc_hi64(Z1_1, Zs3, mt5);
    mt2 = mad_lo_cc64(Z1_2, Zs0, mt2);
    mt3 = madc_lo_cc64(Z1_2, Zs1, mt3);
    mt4 = madc_lo_cc64(Z1_2, Zs2, mt4);
    mt5 = madc_lo_cc64(Z1_2, Zs3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(Z1_2, Zs0, mt3);
    mt4 = madc_hi_cc64(Z1_2, Zs1, mt4);
    mt5 = madc_hi_cc64(Z1_2, Zs2, mt5);
    mt6 = madc_hi64(Z1_2, Zs3, mt6);
    mt3 = mad_lo_cc64(Z1_3, Zs0, mt3);
    mt4 = madc_lo_cc64(Z1_3, Zs1, mt4);
    mt5 = madc_lo_cc64(Z1_3, Zs2, mt5);
    mt6 = madc_lo_cc64(Z1_3, Zs3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(Z1_3, Zs0, mt4);
    mt5 = madc_hi_cc64(Z1_3, Zs1, mt5);
    mt6 = madc_hi_cc64(Z1_3, Zs2, mt6);
    mt7 = madc_hi64(Z1_3, Zs3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    Zc0 = mt0; Zc1 = mt1; Zc2 = mt2; Zc3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 4: S2 = y2 * Z1cu  (M)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(y2_0, Zc0);
    mt1 = mulhi64(y2_0, Zc0);
    mt1 = mad_lo_cc64(y2_0, Zc1, mt1);
    mt2 = madc_hi64(y2_0, Zc1, 0);
    mt2 = mad_lo_cc64(y2_0, Zc2, mt2);
    mt3 = madc_hi64(y2_0, Zc2, 0);
    mt3 = mad_lo_cc64(y2_0, Zc3, mt3);
    mt4 = madc_hi64(y2_0, Zc3, 0);
    mt1 = mad_lo_cc64(y2_1, Zc0, mt1);
    mt2 = madc_lo_cc64(y2_1, Zc1, mt2);
    mt3 = madc_lo_cc64(y2_1, Zc2, mt3);
    mt4 = madc_lo_cc64(y2_1, Zc3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(y2_1, Zc0, mt2);
    mt3 = madc_hi_cc64(y2_1, Zc1, mt3);
    mt4 = madc_hi_cc64(y2_1, Zc2, mt4);
    mt5 = madc_hi64(y2_1, Zc3, mt5);
    mt2 = mad_lo_cc64(y2_2, Zc0, mt2);
    mt3 = madc_lo_cc64(y2_2, Zc1, mt3);
    mt4 = madc_lo_cc64(y2_2, Zc2, mt4);
    mt5 = madc_lo_cc64(y2_2, Zc3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(y2_2, Zc0, mt3);
    mt4 = madc_hi_cc64(y2_2, Zc1, mt4);
    mt5 = madc_hi_cc64(y2_2, Zc2, mt5);
    mt6 = madc_hi64(y2_2, Zc3, mt6);
    mt3 = mad_lo_cc64(y2_3, Zc0, mt3);
    mt4 = madc_lo_cc64(y2_3, Zc1, mt4);
    mt5 = madc_lo_cc64(y2_3, Zc2, mt5);
    mt6 = madc_lo_cc64(y2_3, Zc3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(y2_3, Zc0, mt4);
    mt5 = madc_hi_cc64(y2_3, Zc1, mt5);
    mt6 = madc_hi_cc64(y2_3, Zc2, mt6);
    mt7 = madc_hi64(y2_3, Zc3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    S0 = mt0; S1 = mt1; S2v = mt2; S3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 5a: H = U2 - X1  (field sub — R12..R15 become dead after this)
    // ═══════════════════════════════════════════════════════════════════════════
    H0 = sub_cc64(U0,  X1_0);
    H1 = subc_cc64(U1, X1_1);
    H2 = subc_cc64(U2v, X1_2);
    H3 = subc_cc64(U3, X1_3);
    sb = subc64(0, 0);
    ap0 = PL0 & sb;
    H0 = add_cc64(H0, ap0);
    H1 = addc_cc64(H1, sb);
    H2 = addc_cc64(H2, sb);
    H3 = addc64(H3, sb);


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 5b: R = S2 - Y1  (field sub — R16..R19 become dead after this)
    // ═══════════════════════════════════════════════════════════════════════════
    Rv0 = sub_cc64(S0,  Y1_0);
    Rv1 = subc_cc64(S1, Y1_1);
    Rv2 = subc_cc64(S2v, Y1_2);
    Rv3 = subc_cc64(S3, Y1_3);
    sb = subc64(0, 0);
    ap0 = PL0 & sb;
    Rv0 = add_cc64(Rv0, ap0);
    Rv1 = addc_cc64(Rv1, sb);
    Rv2 = addc_cc64(Rv2, sb);
    Rv3 = addc64(Rv3, sb);


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 6: Hsq = H * H  (squaring — a = b = H)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(H0, H0);
    mt1 = mulhi64(H0, H0);
    mt1 = mad_lo_cc64(H0, H1, mt1);
    mt2 = madc_hi64(H0, H1, 0);
    mt2 = mad_lo_cc64(H0, H2, mt2);
    mt3 = madc_hi64(H0, H2, 0);
    mt3 = mad_lo_cc64(H0, H3, mt3);
    mt4 = madc_hi64(H0, H3, 0);
    mt1 = mad_lo_cc64(H1, H0, mt1);
    mt2 = madc_lo_cc64(H1, H1, mt2);
    mt3 = madc_lo_cc64(H1, H2, mt3);
    mt4 = madc_lo_cc64(H1, H3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(H1, H0, mt2);
    mt3 = madc_hi_cc64(H1, H1, mt3);
    mt4 = madc_hi_cc64(H1, H2, mt4);
    mt5 = madc_hi64(H1, H3, mt5);
    mt2 = mad_lo_cc64(H2, H0, mt2);
    mt3 = madc_lo_cc64(H2, H1, mt3);
    mt4 = madc_lo_cc64(H2, H2, mt4);
    mt5 = madc_lo_cc64(H2, H3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(H2, H0, mt3);
    mt4 = madc_hi_cc64(H2, H1, mt4);
    mt5 = madc_hi_cc64(H2, H2, mt5);
    mt6 = madc_hi64(H2, H3, mt6);
    mt3 = mad_lo_cc64(H3, H0, mt3);
    mt4 = madc_lo_cc64(H3, H1, mt4);
    mt5 = madc_lo_cc64(H3, H2, mt5);
    mt6 = madc_lo_cc64(H3, H3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(H3, H0, mt4);
    mt5 = madc_hi_cc64(H3, H1, mt5);
    mt6 = madc_hi_cc64(H3, H2, mt6);
    mt7 = madc_hi64(H3, H3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    Hs0 = mt0; Hs1 = mt1; Hs2 = mt2; Hs3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 7: Z3 = Z1 * H  (M — independent of Hsq, latency hidden at warp level)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(Z1_0, H0);
    mt1 = mulhi64(Z1_0, H0);
    mt1 = mad_lo_cc64(Z1_0, H1, mt1);
    mt2 = madc_hi64(Z1_0, H1, 0);
    mt2 = mad_lo_cc64(Z1_0, H2, mt2);
    mt3 = madc_hi64(Z1_0, H2, 0);
    mt3 = mad_lo_cc64(Z1_0, H3, mt3);
    mt4 = madc_hi64(Z1_0, H3, 0);
    mt1 = mad_lo_cc64(Z1_1, H0, mt1);
    mt2 = madc_lo_cc64(Z1_1, H1, mt2);
    mt3 = madc_lo_cc64(Z1_1, H2, mt3);
    mt4 = madc_lo_cc64(Z1_1, H3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(Z1_1, H0, mt2);
    mt3 = madc_hi_cc64(Z1_1, H1, mt3);
    mt4 = madc_hi_cc64(Z1_1, H2, mt4);
    mt5 = madc_hi64(Z1_1, H3, mt5);
    mt2 = mad_lo_cc64(Z1_2, H0, mt2);
    mt3 = madc_lo_cc64(Z1_2, H1, mt3);
    mt4 = madc_lo_cc64(Z1_2, H2, mt4);
    mt5 = madc_lo_cc64(Z1_2, H3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(Z1_2, H0, mt3);
    mt4 = madc_hi_cc64(Z1_2, H1, mt4);
    mt5 = madc_hi_cc64(Z1_2, H2, mt5);
    mt6 = madc_hi64(Z1_2, H3, mt6);
    mt3 = mad_lo_cc64(Z1_3, H0, mt3);
    mt4 = madc_lo_cc64(Z1_3, H1, mt4);
    mt5 = madc_lo_cc64(Z1_3, H2, mt5);
    mt6 = madc_lo_cc64(Z1_3, H3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(Z1_3, H0, mt4);
    mt5 = madc_hi_cc64(Z1_3, H1, mt5);
    mt6 = madc_hi_cc64(Z1_3, H2, mt6);
    mt7 = madc_hi64(Z1_3, H3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    Z30 = mt0; Z31 = mt1; Z32 = mt2; Z33 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 8: Hcu = H * Hsq  (M)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(H0, Hs0);
    mt1 = mulhi64(H0, Hs0);
    mt1 = mad_lo_cc64(H0, Hs1, mt1);
    mt2 = madc_hi64(H0, Hs1, 0);
    mt2 = mad_lo_cc64(H0, Hs2, mt2);
    mt3 = madc_hi64(H0, Hs2, 0);
    mt3 = mad_lo_cc64(H0, Hs3, mt3);
    mt4 = madc_hi64(H0, Hs3, 0);
    mt1 = mad_lo_cc64(H1, Hs0, mt1);
    mt2 = madc_lo_cc64(H1, Hs1, mt2);
    mt3 = madc_lo_cc64(H1, Hs2, mt3);
    mt4 = madc_lo_cc64(H1, Hs3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(H1, Hs0, mt2);
    mt3 = madc_hi_cc64(H1, Hs1, mt3);
    mt4 = madc_hi_cc64(H1, Hs2, mt4);
    mt5 = madc_hi64(H1, Hs3, mt5);
    mt2 = mad_lo_cc64(H2, Hs0, mt2);
    mt3 = madc_lo_cc64(H2, Hs1, mt3);
    mt4 = madc_lo_cc64(H2, Hs2, mt4);
    mt5 = madc_lo_cc64(H2, Hs3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(H2, Hs0, mt3);
    mt4 = madc_hi_cc64(H2, Hs1, mt4);
    mt5 = madc_hi_cc64(H2, Hs2, mt5);
    mt6 = madc_hi64(H2, Hs3, mt6);
    mt3 = mad_lo_cc64(H3, Hs0, mt3);
    mt4 = madc_lo_cc64(H3, Hs1, mt4);
    mt5 = madc_lo_cc64(H3, Hs2, mt5);
    mt6 = madc_lo_cc64(H3, Hs3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(H3, Hs0, mt4);
    mt5 = madc_hi_cc64(H3, Hs1, mt5);
    mt6 = madc_hi_cc64(H3, Hs2, mt6);
    mt7 = madc_hi64(H3, Hs3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    Hc0 = mt0; Hc1 = mt1; Hc2 = mt2; Hc3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 9: X1Hsq = X1 * Hsq  (M)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(X1_0, Hs0);
    mt1 = mulhi64(X1_0, Hs0);
    mt1 = mad_lo_cc64(X1_0, Hs1, mt1);
    mt2 = madc_hi64(X1_0, Hs1, 0);
    mt2 = mad_lo_cc64(X1_0, Hs2, mt2);
    mt3 = madc_hi64(X1_0, Hs2, 0);
    mt3 = mad_lo_cc64(X1_0, Hs3, mt3);
    mt4 = madc_hi64(X1_0, Hs3, 0);
    mt1 = mad_lo_cc64(X1_1, Hs0, mt1);
    mt2 = madc_lo_cc64(X1_1, Hs1, mt2);
    mt3 = madc_lo_cc64(X1_1, Hs2, mt3);
    mt4 = madc_lo_cc64(X1_1, Hs3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(X1_1, Hs0, mt2);
    mt3 = madc_hi_cc64(X1_1, Hs1, mt3);
    mt4 = madc_hi_cc64(X1_1, Hs2, mt4);
    mt5 = madc_hi64(X1_1, Hs3, mt5);
    mt2 = mad_lo_cc64(X1_2, Hs0, mt2);
    mt3 = madc_lo_cc64(X1_2, Hs1, mt3);
    mt4 = madc_lo_cc64(X1_2, Hs2, mt4);
    mt5 = madc_lo_cc64(X1_2, Hs3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(X1_2, Hs0, mt3);
    mt4 = madc_hi_cc64(X1_2, Hs1, mt4);
    mt5 = madc_hi_cc64(X1_2, Hs2, mt5);
    mt6 = madc_hi64(X1_2, Hs3, mt6);
    mt3 = mad_lo_cc64(X1_3, Hs0, mt3);
    mt4 = madc_lo_cc64(X1_3, Hs1, mt4);
    mt5 = madc_lo_cc64(X1_3, Hs2, mt5);
    mt6 = madc_lo_cc64(X1_3, Hs3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(X1_3, Hs0, mt4);
    mt5 = madc_hi_cc64(X1_3, Hs1, mt5);
    mt6 = madc_hi_cc64(X1_3, Hs2, mt6);
    mt7 = madc_hi64(X1_3, Hs3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    XH0 = mt0; XH1 = mt1; XH2 = mt2; XH3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 10: Rsq = R * R  (squaring — a = b = R)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(Rv0, Rv0);
    mt1 = mulhi64(Rv0, Rv0);
    mt1 = mad_lo_cc64(Rv0, Rv1, mt1);
    mt2 = madc_hi64(Rv0, Rv1, 0);
    mt2 = mad_lo_cc64(Rv0, Rv2, mt2);
    mt3 = madc_hi64(Rv0, Rv2, 0);
    mt3 = mad_lo_cc64(Rv0, Rv3, mt3);
    mt4 = madc_hi64(Rv0, Rv3, 0);
    mt1 = mad_lo_cc64(Rv1, Rv0, mt1);
    mt2 = madc_lo_cc64(Rv1, Rv1, mt2);
    mt3 = madc_lo_cc64(Rv1, Rv2, mt3);
    mt4 = madc_lo_cc64(Rv1, Rv3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(Rv1, Rv0, mt2);
    mt3 = madc_hi_cc64(Rv1, Rv1, mt3);
    mt4 = madc_hi_cc64(Rv1, Rv2, mt4);
    mt5 = madc_hi64(Rv1, Rv3, mt5);
    mt2 = mad_lo_cc64(Rv2, Rv0, mt2);
    mt3 = madc_lo_cc64(Rv2, Rv1, mt3);
    mt4 = madc_lo_cc64(Rv2, Rv2, mt4);
    mt5 = madc_lo_cc64(Rv2, Rv3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(Rv2, Rv0, mt3);
    mt4 = madc_hi_cc64(Rv2, Rv1, mt4);
    mt5 = madc_hi_cc64(Rv2, Rv2, mt5);
    mt6 = madc_hi64(Rv2, Rv3, mt6);
    mt3 = mad_lo_cc64(Rv3, Rv0, mt3);
    mt4 = madc_lo_cc64(Rv3, Rv1, mt4);
    mt5 = madc_lo_cc64(Rv3, Rv2, mt5);
    mt6 = madc_lo_cc64(Rv3, Rv3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(Rv3, Rv0, mt4);
    mt5 = madc_hi_cc64(Rv3, Rv1, mt5);
    mt6 = madc_hi_cc64(Rv3, Rv2, mt6);
    mt7 = madc_hi64(Rv3, Rv3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    Rs0 = mt0; Rs1 = mt1; Rs2 = mt2; Rs3 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 11: X3 = Rsq - Hcu - 2*X1Hsq
    // ═══════════════════════════════════════════════════════════════════════════

    // 11a: X3 = Rsq - Hcu
    X30 = sub_cc64(Rs0, Hc0);
    X31 = subc_cc64(Rs1, Hc1);
    X32 = subc_cc64(Rs2, Hc2);
    X33 = subc_cc64(Rs3, Hc3);
    sb = subc64(0, 0);
    ap0 = PL0 & sb;
    X30 = add_cc64(X30, ap0);
    X31 = addc_cc64(X31, sb);
    X32 = addc_cc64(X32, sb);
    X33 = addc64(X33, sb);

    // 11b: 2*XH = XH + XH mod P
    XH2a = add_cc64(XH0, XH0);
    XH2b = addc_cc64(XH1, XH1);
    XH2c = addc_cc64(XH2, XH2);
    XH2d = addc_cc64(XH3, XH3);
    dbl_cy = addc64(0, 0);
    ds0 = sub_cc64(XH2a, 0xFFFFFFFEFFFFFC2F);
    ds1 = subc_cc64(XH2b, 0xFFFFFFFFFFFFFFFF);
    ds2 = subc_cc64(XH2c, 0xFFFFFFFFFFFFFFFF);
    ds3 = subc_cc64(XH2d, 0xFFFFFFFFFFFFFFFF);
    db  = subc64(dbl_cy, 0);
    dnb = ~db;
    XH2a = (XH2a & db) | (ds0 & dnb);
    XH2b = (XH2b & db) | (ds1 & dnb);
    XH2c = (XH2c & db) | (ds2 & dnb);
    XH2d = (XH2d & db) | (ds3 & dnb);

    // 11c: X3 -= 2*XH
    X30 = sub_cc64(X30, XH2a);
    X31 = subc_cc64(X31, XH2b);
    X32 = subc_cc64(X32, XH2c);
    X33 = subc_cc64(X33, XH2d);
    sb = subc64(0, 0);
    ap0 = PL0 & sb;
    X30 = add_cc64(X30, ap0);
    X31 = addc_cc64(X31, sb);
    X32 = addc_cc64(X32, sb);
    X33 = addc64(X33, sb);


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 12: DX = X1Hsq - X3  (for Y3 computation)
    // ═══════════════════════════════════════════════════════════════════════════
    DX0 = sub_cc64(XH0, X30);
    DX1 = subc_cc64(XH1, X31);
    DX2 = subc_cc64(XH2, X32);
    DX3 = subc_cc64(XH3, X33);
    sb  = subc64(0, 0);
    ap0 = PL0 & sb;
    DX0 = add_cc64(DX0, ap0);
    DX1 = addc_cc64(DX1, sb);
    DX2 = addc_cc64(DX2, sb);
    DX3 = addc64(DX3, sb);


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 13: T0 = R * DX  (M — first Y3 mul)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(Rv0, DX0);
    mt1 = mulhi64(Rv0, DX0);
    mt1 = mad_lo_cc64(Rv0, DX1, mt1);
    mt2 = madc_hi64(Rv0, DX1, 0);
    mt2 = mad_lo_cc64(Rv0, DX2, mt2);
    mt3 = madc_hi64(Rv0, DX2, 0);
    mt3 = mad_lo_cc64(Rv0, DX3, mt3);
    mt4 = madc_hi64(Rv0, DX3, 0);
    mt1 = mad_lo_cc64(Rv1, DX0, mt1);
    mt2 = madc_lo_cc64(Rv1, DX1, mt2);
    mt3 = madc_lo_cc64(Rv1, DX2, mt3);
    mt4 = madc_lo_cc64(Rv1, DX3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(Rv1, DX0, mt2);
    mt3 = madc_hi_cc64(Rv1, DX1, mt3);
    mt4 = madc_hi_cc64(Rv1, DX2, mt4);
    mt5 = madc_hi64(Rv1, DX3, mt5);
    mt2 = mad_lo_cc64(Rv2, DX0, mt2);
    mt3 = madc_lo_cc64(Rv2, DX1, mt3);
    mt4 = madc_lo_cc64(Rv2, DX2, mt4);
    mt5 = madc_lo_cc64(Rv2, DX3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(Rv2, DX0, mt3);
    mt4 = madc_hi_cc64(Rv2, DX1, mt4);
    mt5 = madc_hi_cc64(Rv2, DX2, mt5);
    mt6 = madc_hi64(Rv2, DX3, mt6);
    mt3 = mad_lo_cc64(Rv3, DX0, mt3);
    mt4 = madc_lo_cc64(Rv3, DX1, mt4);
    mt5 = madc_lo_cc64(Rv3, DX2, mt5);
    mt6 = madc_lo_cc64(Rv3, DX3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(Rv3, DX0, mt4);
    mt5 = madc_hi_cc64(Rv3, DX1, mt5);
    mt6 = madc_hi_cc64(Rv3, DX2, mt6);
    mt7 = madc_hi64(Rv3, DX3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    T00 = mt0; T01 = mt1; T02 = mt2; T03 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 14: T1 = Y1 * Hcu  (M — second Y3 mul, independent of T0)
    // ═══════════════════════════════════════════════════════════════════════════
    mt0 = mul_lo64(Y1_0, Hc0);
    mt1 = mulhi64(Y1_0, Hc0);
    mt1 = mad_lo_cc64(Y1_0, Hc1, mt1);
    mt2 = madc_hi64(Y1_0, Hc1, 0);
    mt2 = mad_lo_cc64(Y1_0, Hc2, mt2);
    mt3 = madc_hi64(Y1_0, Hc2, 0);
    mt3 = mad_lo_cc64(Y1_0, Hc3, mt3);
    mt4 = madc_hi64(Y1_0, Hc3, 0);
    mt1 = mad_lo_cc64(Y1_1, Hc0, mt1);
    mt2 = madc_lo_cc64(Y1_1, Hc1, mt2);
    mt3 = madc_lo_cc64(Y1_1, Hc2, mt3);
    mt4 = madc_lo_cc64(Y1_1, Hc3, mt4);
    mt5 = addc64(0, 0);
    mt2 = mad_hi_cc64(Y1_1, Hc0, mt2);
    mt3 = madc_hi_cc64(Y1_1, Hc1, mt3);
    mt4 = madc_hi_cc64(Y1_1, Hc2, mt4);
    mt5 = madc_hi64(Y1_1, Hc3, mt5);
    mt2 = mad_lo_cc64(Y1_2, Hc0, mt2);
    mt3 = madc_lo_cc64(Y1_2, Hc1, mt3);
    mt4 = madc_lo_cc64(Y1_2, Hc2, mt4);
    mt5 = madc_lo_cc64(Y1_2, Hc3, mt5);
    mt6 = addc64(0, 0);
    mt3 = mad_hi_cc64(Y1_2, Hc0, mt3);
    mt4 = madc_hi_cc64(Y1_2, Hc1, mt4);
    mt5 = madc_hi_cc64(Y1_2, Hc2, mt5);
    mt6 = madc_hi64(Y1_2, Hc3, mt6);
    mt3 = mad_lo_cc64(Y1_3, Hc0, mt3);
    mt4 = madc_lo_cc64(Y1_3, Hc1, mt4);
    mt5 = madc_lo_cc64(Y1_3, Hc2, mt5);
    mt6 = madc_lo_cc64(Y1_3, Hc3, mt6);
    mt7 = addc64(0, 0);
    mt4 = mad_hi_cc64(Y1_3, Hc0, mt4);
    mt5 = madc_hi_cc64(Y1_3, Hc1, mt5);
    mt6 = madc_hi_cc64(Y1_3, Hc2, mt6);
    mt7 = madc_hi64(Y1_3, Hc3, mt7);
    mt4h = mt4;
    mt0 = mad_lo_cc64(mt4, c977, mt0);
    mt1 = madc_lo_cc64(mt5, c977, mt1);
    mt2 = madc_lo_cc64(mt6, c977, mt2);
    mt3 = madc_lo_cc64(mt7, c977, mt3);
    mt4l = addc64(0, 0);
    mt1 = mad_hi_cc64(mt4, c977, mt1);
    mt2 = madc_hi_cc64(mt5, c977, mt2);
    mt3 = madc_hi_cc64(mt6, c977, mt3);
    mt4 = madc_hi64(mt7, c977, mt4l);
    mt4l = mt4h << c32; mt4h = mt4h >> c32;
    mt5l = mt5 << c32; mt5h = mt5 >> c32;
    mt6l = mt6 << c32; mt6h = mt6 >> c32;
    mt7l = mt7 << c32; mt7h = mt7 >> c32;
    mt0 = add_cc64(mt0, mt4l);
    mt1 = addc_cc64(mt1, mt4h);
    mt1 = addc_cc64(mt1, mt5l);
    mt2 = addc_cc64(mt2, mt5h);
    mt2 = addc_cc64(mt2, mt6l);
    mt3 = addc_cc64(mt3, mt6h);
    mt3 = addc_cc64(mt3, mt7l);
    mt4 = addc64(mt7h, mt4);
    t4C_lo = mul_lo64(mt4, cC);
    t4C_hi = mulhi64(mt4, cC);
    mt0 = add_cc64(mt0, t4C_lo);
    mt1 = addc_cc64(mt1, t4C_hi);
    mt2 = addc_cc64(mt2, 0);
    mt3 = addc64(mt3, 0);
    T10 = mt0; T11 = mt1; T12 = mt2; T13 = mt3;


    // ═══════════════════════════════════════════════════════════════════════════
    // Step 15: Y3 = T0 - T1
    // ═══════════════════════════════════════════════════════════════════════════
    Y30 = sub_cc64(T00, T10);
    Y31 = subc_cc64(T01, T11);
    Y32 = subc_cc64(T02, T12);
    Y33 = subc_cc64(T03, T13);
    sb  = subc64(0, 0);
    ap0 = PL0 & sb;
    Y30 = add_cc64(Y30, ap0);
    Y31 = addc_cc64(Y31, sb);
    Y32 = addc_cc64(Y32, sb);
    Y33 = addc64(Y33, sb);


    // ═══════════════════════════════════════════════════════════════════════════
    // Write-back: update locked walker registers with new Jacobian point
    // ═══════════════════════════════════════════════════════════════════════════
    X1_0 = X30; X1_1 = X31; X1_2 = X32; X1_3 = X33;
    Y1_0 = Y30; Y1_1 = Y31; Y1_2 = Y32; Y1_3 = Y33;
    Z1_0 = Z30; Z1_1 = Z31; Z1_2 = Z32; Z1_3 = Z33;
}


// ─── Production transmission (Pollard's Rho, 160 blocks × 256 threads) ────────
transmission pollard_rho_step {
    grid  (160, 1, 1);
    block (256, 1, 1);
    motor point_add_mixed {
        inout u64 X1_0; inout u64 X1_1; inout u64 X1_2; inout u64 X1_3;
        inout u64 Y1_0; inout u64 Y1_1; inout u64 Y1_2; inout u64 Y1_3;
        inout u64 Z1_0; inout u64 Z1_1; inout u64 Z1_2; inout u64 Z1_3;
        in u64 x2_0; in u64 x2_1; in u64 x2_2; in u64 x2_3;
        in u64 y2_0; in u64 y2_1; in u64 y2_2; in u64 y2_3;
    }
}

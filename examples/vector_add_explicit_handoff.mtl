// Explicit Register Handoff (Precision Bellhousing) test case.
// Derived directly from the phase5 cruise control artifacts (1850 real WallBreakers).
// The motor declares the working splines (R2/R3/R4) that the transmission
// maps as rigid splined shafts with @boundary_lock(strict_zero_temps).
// Goal: prove the GPU can finally hit closer to 192 GB/s because the code
// no longer manufactures 18 generic temps at the motor→transmission boundary.

transmission vector_add_explicit {
    grid  (256, 1, 1);
    block (256, 1, 1);

    motor vector_add {
        // Must exactly match the 5 top-level @register decls in the motor body
        in  R0 float* x_base;
        in  R1 float* y_base;
        in  R2 u64   x_addr_shaft;   // direct physical address spline
        in  R3 u64   y_addr_shaft;   // direct physical address spline
        inout R4 f32 data_shaft;     // the actual data value crosses here
    }
}

motor vector_add {
    // Interface items (must match contract param + port count for signature check)
    @register(R0) float* x;
    @register(R1) float* y;

    // Working splines (the actual bulletproof handoff — these are the rigid shafts)
    @register(R2) u64 x_addr;   // working spline for address math (mad.wide target)
    @register(R3) u64 y_addr;   // working spline for store address
    @register(R4) f32 t_val;    // data spline — the value lives here during movement

    // Real loop body (exact pattern the 150M+ agents are mutating)
    for (int i = 0; i < 1024; i = i + 1) {
        float t;
        t = x[i];
        y[i] = t + 1.0;
    }
}
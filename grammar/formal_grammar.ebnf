(* MTLang Formal Grammar - Phase 1 Draft *)

program
    : top_level_decl* EOF
    ;

top_level_decl
    : motor_decl
    | transmission_decl
    | host_decl
    ;

motor_decl
    : 'motor' IDENTIFIER (register_annotation)? '{' motor_stmt* '}'
    ;

register_annotation
    : '@register' '(' REGISTER ')'
    ;

REGISTER
    : 'R' [0-9]+
    ;

motor_stmt
    : var_decl
    | assignment_stmt
    | for_stmt
    | if_stmt
    | return_stmt
    ;

var_decl
    : (register_annotation)? type IDENTIFIER array_suffix? ';'
    ;

array_suffix
    : '[' expr ']'
    ;

assignment_stmt
    : expr '=' expr ';'
    ;

for_stmt
    : 'for' '(' for_init ';' expr ';' for_update ')' block
    ;

for_init
    : var_decl
    | assignment_stmt
    ;

for_update
    : expr
    ;

if_stmt
    : 'if' '(' expr ')' block ( 'else' block )?
    ;

return_stmt
    : 'return' expr? ';'
    ;

block
    : '{' motor_stmt* '}'
    ;

transmission_decl
    : 'transmission' IDENTIFIER '{' 
        grid_decl
        block_decl
        (stream_decl)?
        motor_contract
      '}'
    ;

grid_decl
    : 'grid' '(' dim3 ')' ';'
    ;

block_decl
    : 'block' '(' dim3 ')' ';'
    ;

stream_decl
    : 'stream' IDENTIFIER ';'
    ;

dim3
    : expr ( ',' expr ( ',' expr )? )?
    ;

motor_contract
    : 'motor' IDENTIFIER '{' transmission_param* '}'
    ;

transmission_param
    : direction type IDENTIFIER (align_annotation)? ';'
    ;

direction
    : 'in' | 'out' | 'inout'
    ;

align_annotation
    : '@align' '(' INTEGER ')'
    ;

type
    : 'float'
    | 'int'
    | 'float' '*'
    | 'int' '*'
    ;

expr
    : IDENTIFIER
    | INTEGER
    | FLOAT
    | expr binary_op expr
    | '(' expr ')'
    | IDENTIFIER '[' expr ']'
    ;

binary_op
    : '+' | '-' | '*' | '/' | '<' | '>' | '==' | '!='
    ;

host_decl
    : /* Host code remains flexible in Phase 1 */
    ;

IDENTIFIER
    : [a-zA-Z_][a-zA-Z0-9_]*
    ;

INTEGER
    : [0-9]+
    ;

FLOAT
    : [0-9]+ '.' [0-9]+
    ;
